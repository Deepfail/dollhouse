{
  // Ensure files are visible in explorer
  "files.exclude": {
    "**/.git": false,
    "**/node_modules": true,
    "**/.DS_Store": true,
    "**/characters/images": true,
    "**/RECOVER": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true,
    "**/characters": true,
    "**/RECOVER": true
  },
  // Increase search limits for large repo
  "search.largeFileSizeLimit": 100,
  "search.maxResults": 20000,
  "search.followSymlinks": false,
  // Workspace specific settings
  "cSpell.words": [
    "conv",
    "deepseek",
    "Dexie",
    "hidream",
    "Lustify",
    "openrouter",
    "Openrouter",
    "Qwen",
    "sdxl"
  ],
  "vitest.rootConfig": "./vite.config.ts",
  "editor.experimentalGpuAcceleration": "on",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.enableImages": true,
  "cSpell.enabledFileTypes": {
    "typescript": false,
    "typescriptreact": false
  },
  "cSpell.enabledSchemes": {
    "file": false
  }
}
